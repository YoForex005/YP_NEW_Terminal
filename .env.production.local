# Production-local overrides (loaded by `next build` / `next start`)
# Browser HTTP must stay same-origin (proxy). Server talks to backend via TERMINAL_API_BASE.

TERMINAL_API_BASE=https://backend.yopips.com
ACCOUNTS_BACKEND_URL=https://backend.yopips.com
ACCOUNTS_BACKEND_BASE_URL=https://backend.yopips.com
DASHBOARD_BACKEND_URL=https://backend.yopips.com
RUST_GATEWAY_HTTP_URL=https://backend.yopips.com
RUST_GATEWAY_PUBLIC_API_BASE_URL=https://backend.yopips.com

# Do NOT point browser HTTP at backend (CORS). Use Next /api/terminal proxy.
NEXT_PUBLIC_TERMINAL_API_BASE=proxy
# Prefer empty for browser; server still uses TERMINAL_API_BASE above.
# Keep for server fallbacks that read NEXT_PUBLIC_*:
NEXT_PUBLIC_API_BASE_URL=https://backend.yopips.com

NEXT_PUBLIC_TERMINAL_WS_BASE=wss://backend.yopips.com
NEXT_PUBLIC_WS_URL=wss://backend.yopips.com/ws
NEXT_PUBLIC_WS_MARKET_URL=wss://backend.yopips.com/ws
NEXT_PUBLIC_WS_OHLC_URL=wss://backend.yopips.com/ws
NEXT_PUBLIC_WS_ACCOUNT_URL=wss://backend.yopips.com/ws
NEXT_PUBLIC_WS_TRADE_URL=wss://backend.yopips.com/ws
RUST_GATEWAY_WS_URL=wss://backend.yopips.com/ws
CPP_REALTIME_WS_URL=wss://backend.yopips.com/ws
MT5_REALTIME_WS_URL=wss://backend.yopips.com/ws
