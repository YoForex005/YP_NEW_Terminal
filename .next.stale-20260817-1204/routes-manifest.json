{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: ws:; frame-src 'self' https://verification.didit.me https://didit.me"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/payments/[...path]",
      "regex": "^/api/payments/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/payments/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]",
      "regex": "^/api/private/accounts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/credentials",
      "regex": "^/api/private/accounts/([^/]+?)/credentials(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/credentials(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/credentials/verify",
      "regex": "^/api/private/accounts/([^/]+?)/credentials/verify(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/credentials/verify(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/mode",
      "regex": "^/api/private/accounts/([^/]+?)/mode(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/mode(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/ohlc-gap-fill",
      "regex": "^/api/private/accounts/([^/]+?)/ohlc\\-gap\\-fill(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/ohlc\\-gap\\-fill(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/password",
      "regex": "^/api/private/accounts/([^/]+?)/password(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/password(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/status",
      "regex": "^/api/private/accounts/([^/]+?)/status(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/status(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/stored-credentials",
      "regex": "^/api/private/accounts/([^/]+?)/stored\\-credentials(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/stored\\-credentials(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/sync-balance",
      "regex": "^/api/private/accounts/([^/]+?)/sync\\-balance(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/sync\\-balance(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/terminal-ohlc-repair",
      "regex": "^/api/private/accounts/([^/]+?)/terminal\\-ohlc\\-repair(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/terminal\\-ohlc\\-repair(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/terminal-session",
      "regex": "^/api/private/accounts/([^/]+?)/terminal\\-session(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/terminal\\-session(?:/)?$"
    },
    {
      "page": "/api/private/accounts/[accountId]/terminal-state",
      "regex": "^/api/private/accounts/([^/]+?)/terminal\\-state(?:/)?$",
      "routeKeys": {
        "nxtPaccountId": "nxtPaccountId"
      },
      "namedRegex": "^/api/private/accounts/(?<nxtPaccountId>[^/]+?)/terminal\\-state(?:/)?$"
    },
    {
      "page": "/api/private/admin/groups/[groupName]/symbols",
      "regex": "^/api/private/admin/groups/([^/]+?)/symbols(?:/)?$",
      "routeKeys": {
        "nxtPgroupName": "nxtPgroupName"
      },
      "namedRegex": "^/api/private/admin/groups/(?<nxtPgroupName>[^/]+?)/symbols(?:/)?$"
    },
    {
      "page": "/api/private/journal/notes/[id]",
      "regex": "^/api/private/journal/notes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/private/journal/notes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/private/support/tickets/[id]",
      "regex": "^/api/private/support/tickets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/private/support/tickets/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/terminal/[...path]",
      "regex": "^/api/terminal/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/terminal/(?<nxtPpath>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/terminal",
      "regex": "^/terminal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terminal(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}