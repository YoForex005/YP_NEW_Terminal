# =============================================================================
# yopips-terminal — environment template
# Backend: PropFirm C++ Backend API (Swagger at <BACKEND_ORIGIN>/docs).
# All backend HTTP endpoints live under the /api prefix.
# Copy to `.env` (gitignored) and fill in your backend origin.
#   cp .env.example .env
# Replace http://BACKEND_HOST:3001 with your backend, e.g. http://192.168.1.38:3001
# =============================================================================

# ── Backend origin (server-side proxy + BFF clients forward here) ────────────
# Must be the bare ORIGIN (no trailing /api) — proxy appends /api/terminal/...
TERMINAL_API_BASE=http://BACKEND_HOST:3001
RUST_GATEWAY_HTTP_URL=http://BACKEND_HOST:3001
RUST_GATEWAY_PUBLIC_API_BASE_URL=http://BACKEND_HOST:3001
NEXT_PUBLIC_API_BASE_URL=http://BACKEND_HOST:3001

# ── Browser → backend: terminal launch / ticket flow ─────────────────────────
# Backend origin = browser calls backend directly (backend must allow CORS/origin).
# `proxy` or empty = browser uses the same-origin Next proxy for REST lifecycle calls.
NEXT_PUBLIC_TERMINAL_API_BASE=proxy
# WS base for /ws/terminal/feed and /ws/terminal/trade — MUST be a direct origin.
NEXT_PUBLIC_TERMINAL_WS_BASE=ws://BACKEND_HOST:3001
# Safe default: validates trade commands without creating MT5 orders.
NEXT_PUBLIC_TERMINAL_TRADE_DRY_RUN=true
# Must remain false unless a separate real-trading rollout has been approved.
NEXT_PUBLIC_ENABLE_REAL_TRADING=false

# ── Legacy realtime WS (used when not on the ticket flow) ────────────────────
NEXT_PUBLIC_WS_URL=ws://BACKEND_HOST:3001/ws
NEXT_PUBLIC_WS_MARKET_URL=ws://BACKEND_HOST:3001/ws/market
NEXT_PUBLIC_WS_OHLC_URL=ws://BACKEND_HOST:3001/ws/ohlc
NEXT_PUBLIC_WS_ACCOUNT_URL=ws://BACKEND_HOST:3001/ws/account
NEXT_PUBLIC_WS_TRADE_URL=ws://BACKEND_HOST:3001/ws/trade

# ── Node WS bridge (server.mjs) — only when running the node bridge ──────────
CPP_REALTIME_WS_URL=ws://BACKEND_HOST:3003
MT5_REALTIME_WS_URL=ws://BACKEND_HOST:3003
HOST=127.0.0.1
PORT=3002
NODE_WS_PATHS=/ws,/api/ws,/stream,/realtime,/
NODE_WS_AUTH_TIMEOUT_MS=10000
NODE_WS_MAX_PENDING_FRAMES=200
WEBTRADER_TOKEN_SECRET=change-me
WEBTRADER_TOKEN_TTL_SECONDS=900

# ── Dev convenience ──────────────────────────────────────────────────────────
DEV_AUTO_AUTH=true
DEV_AUTO_PROVISION_USERS=false

# ── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_DATA_SOURCE=api
NEXT_PUBLIC_ENABLE_SYNTHETIC_MARKET_DATA=false
NEXT_PUBLIC_ENABLE_LEGACY_QUOTES_SOCKET_IO=false

# ── Optional integrations ────────────────────────────────────────────────────
# MARKETAUX_API_TOKEN=
# REDIS_URL=redis://127.0.0.1:6379
# DATABASE_URL=postgresql://crm:crm@127.0.0.1:5432/forex_crm
# MT5_SERVER_HOST=
# MT5_SERVER_PORT=443
